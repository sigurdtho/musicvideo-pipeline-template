# Copy to .env (never commit .env). All values are placeholders.
PROJECTS_DIR=/path/to/projects            # parent folder of film projects (new_project.sh)
ENVS_DIR=/path/to/shared/envs             # shared tool venvs (pipeline, acestep, whisperx, ...)
COMFY_DIR=/path/to/ComfyUI                # ComfyUI install; models under $COMFY_DIR/models
COMFY_URL=http://127.0.0.1:8188
REVIEW_DIR=/path/to/synced/review-folder  # e.g. a Dropbox/Syncthing folder you open on your phone
GPU_LOCK=$HOME/.cache/mvp/gpu.lock
CLAUDE_BIN=claude
CLAUDE_MODEL=opus
VRAM_BUSY_MB=16000
JOB_UNIT_GLOBS="mvp-*"
